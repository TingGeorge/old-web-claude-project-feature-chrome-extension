{
  "manifest_version": 3,
  "name": "Claude Folders",
  "version": "1.0.0",
  "description": "Organize your Claude chats and Claude Code sessions into folders in the sidebar, like the old Projects.",
  "permissions": ["storage", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/store.js", "src/styles.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Claude Folders",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_ui": { "page": "popup/popup.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
